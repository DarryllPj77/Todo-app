<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- These presentation types use only .NET APIs. Compile the actual client
       sources here so behavior tests do not require a native MAUI test host. -->
  <ItemGroup>
    <Compile Include="..\..\src\TodoApp.Maui\Services\LocationTaskCatalog.cs" Link="Client\LocationTaskCatalog.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\LocationReminderService.cs" Link="Client\LocationReminderService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ICalendarFileExporter.cs" Link="Client\ICalendarFileExporter.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleOAuth*.cs" Link="Client\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleLoopbackBroker.cs" Link="Client\GoogleLoopbackBroker.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleConnectionService.cs" Link="Client\GoogleConnectionService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleCalendarApi.cs" Link="Client\GoogleCalendarApi.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleEventLinkService.cs" Link="Client\GoogleEventLinkService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleEventReviewService.cs" Link="Client\GoogleEventReviewService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleCalendarFeedApi.cs" Link="Client\GoogleCalendarFeedApi.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\GoogleCalendarFeedService.cs" Link="Client\GoogleCalendarFeedService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\ViewModels\*.cs" Link="Client\ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TodoApp.Maui\Models\*.cs" Link="Client\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\FocusTaskCatalog.cs" Link="Client\FocusTaskCatalog.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\FocusService.cs" Link="Client\FocusService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ITaskNavigation.cs" Link="Client\ITaskNavigation.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\IClientSettings.cs" Link="Client\IClientSettings.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ApiClientException.cs" Link="Client\ApiClientException.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ClientSession.cs" Link="Client\ClientSession.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\IReminderPlatform.cs" Link="Client\IReminderPlatform.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ReminderTaskCatalog.cs" Link="Client\ReminderTaskCatalog.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ReminderService.cs" Link="Client\ReminderService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\ReminderAwareTaskService.cs" Link="Client\ReminderAwareTaskService.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\SyncEngine.cs" Link="Client\SyncEngine.cs" />
    <Compile Include="..\..\src\TodoApp.Maui\Services\TodoApiClient.cs" Link="Client\TodoApiClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TodoApp.Domain\TodoApp.Domain.csproj" />
    <ProjectReference Include="..\..\src\TodoApp.Infrastructure\TodoApp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TodoApp.Api\TodoApp.Api.csproj" />
  </ItemGroup>

</Project>
