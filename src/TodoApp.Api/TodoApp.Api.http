@TodoApp.Api_HostAddress = https://localhost:7114
@accessToken = paste-access-token-here
@email = replace-with-local-test-email
@password = replace-with-local-test-password

### Placeholder values only: never commit real passwords or tokens here
POST {{TodoApp.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login; copy the returned accessToken into your HTTP client's private variable
POST {{TodoApp.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Current account
GET {{TodoApp.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}

### Public liveness

GET {{TodoApp.Api_HostAddress}}/api/health
Accept: application/json

### List tasks; valid filters: All, Pending, Completed, DueToday, HighPriority
GET {{TodoApp.Api_HostAddress}}/api/tasks?filter=All
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create a task; copy the returned id into taskId below
POST {{TodoApp.Api_HostAddress}}/api/tasks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Learn REST",
  "description": "Try the five task endpoints",
  "dueDate": "2026-11-20",
  "priority": "High",
  "categoryName": "Learning",
  "tags": ["learning", "api"],
  "isCompleted": false
}

### Replace this ID with the created task's ID
@taskId = 00000000-0000-0000-0000-000000000000

GET {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Replace editable fields; omitted/null tags preserve tags, [] explicitly clears them
PUT {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Learn REST",
  "description": null,
  "dueDate": null,
  "priority": "Normal",
  "categoryName": null,
  "tags": [],
  "isCompleted": true
}

### Change only the parent; null detaches, otherwise use an existing same-account task ID
PUT {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}/parent
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"id":null}

### Configure completion-based monthly recurrence; use {"rule":null} to stop
PUT {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}/recurrence
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rule":{"frequency":"Monthly","interval":1,"anchorDate":"2026-11-30"}}

### Complete exactly this expected occurrence; copy recurrence from the latest task response
POST {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}/occurrences/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"rule":{"frequency":"Monthly","interval":1,"anchorDate":"2026-11-30"},"occurrence":0,"ruleStart":0}

### Change only manual urgency/importance; Unclassified explicitly clears
PUT {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}/quadrant
Authorization: Bearer {{accessToken}}
Content-Type: application/json

"ImportantNotUrgent"

### Replace prerequisites only; [] clears, otherwise supply same-account task GUIDs
PUT {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}/prerequisites
Authorization: Bearer {{accessToken}}
Content-Type: application/json

[]

### Delete a disposable task; move/delete children and remove incoming dependency links first
DELETE {{TodoApp.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
