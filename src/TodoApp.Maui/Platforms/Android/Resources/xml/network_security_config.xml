<?xml version="1.0" encoding="utf-8"?>
<!-- API 24+: no cleartext, user CA/debug overrides or host-specific exceptions. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
