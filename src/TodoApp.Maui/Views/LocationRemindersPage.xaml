<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TodoApp.Maui.ViewModels" xmlns:location="clr-namespace:TodoApp.Domain.Location;assembly=TodoApp.Domain"
             x:Class="TodoApp.Maui.Views.LocationRemindersPage" x:DataType="vm:LocationRemindersViewModel"
             Title="Location reminders" Style="{StaticResource TaskPage}">
    <ScrollView><VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="850" HorizontalOptions="Fill">
        <Label Text="Location reminders" Style="{StaticResource TaskHeading}" SemanticProperties.HeadingLevel="Level1" />
        <Label Text="Manual checks run when you press Check arrivals now. Supported platforms also offer a separate explicit device-only background run. Page-active native sessions require packaged Windows. All require reliable outside evidence before inside arrival; delivery depends on location accuracy, notification permission and OS policy." />
        <Picker Title="Workspace" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding Workspace}" IsEnabled="{Binding IsIdle}" />
        <Button Text="Refresh tasks and saved places" Command="{Binding RefreshCommand}" Style="{StaticResource TaskAction}" />
        <CollectionView ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" SelectionMode="Single" HeightRequest="220" IsEnabled="{Binding IsIdle}">
            <CollectionView.EmptyView><Label Text="No saved location reminders in this workspace." Padding="12" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="location:LocationReminder">
                <Border Style="{StaticResource TaskCard}" Margin="0,0,0,8"><Label Text="{Binding Label}" LineBreakMode="WordWrap" /></Border>
            </DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding Details}" LineBreakMode="WordWrap" />
        <Button Text="New place reminder" Command="{Binding NewCommand}" Style="{StaticResource TaskAction}" />
        <Picker Title="Pending task" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" ItemDisplayBinding="{Binding Title, x:DataType=location:LocationTask}" IsEnabled="{Binding IsIdle}" />
        <Entry Placeholder="Place name (1-60 characters)" Text="{Binding PlaceName}" MaxLength="60" IsEnabled="{Binding IsIdle}" SemanticProperties.Description="Place name" />
        <Entry Placeholder="Latitude (-90 to 90, decimal point)" Text="{Binding Latitude}" IsEnabled="{Binding IsIdle}" SemanticProperties.Description="Latitude" />
        <Entry Placeholder="Longitude (-180 to 180, decimal point)" Text="{Binding Longitude}" IsEnabled="{Binding IsIdle}" SemanticProperties.Description="Longitude" />
        <Entry Placeholder="Radius in meters (100-5000)" Text="{Binding Radius}" Keyboard="Numeric" IsEnabled="{Binding IsIdle}" SemanticProperties.Description="Arrival radius in meters" />
        <Button Text="Use current location for draft" Command="{Binding PositionCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Save and arm / rearm" Command="{Binding SaveCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Allow/check notifications" Command="{Binding PermissionCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Check arrivals now" Command="{Binding CheckCommand}" Style="{StaticResource TaskAction}" />
        <Label Text="Native session (packaged Windows)" FontSize="20" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding NativeCapability}" LineBreakMode="WordWrap" />
        <Button Text="Start native session for armed places" Command="{Binding StartNativeCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Stop native session / retry cleanup" Command="{Binding StopNativeCommand}" Style="{StaticResource TaskAction}" />
        <Label Text="{Binding NativeStatus}" LineBreakMode="WordWrap" />
        <Label Text="Device background run" FontSize="20" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding BackgroundCapability}" LineBreakMode="WordWrap" />
        <Button Text="Start 30-minute background run for selected place" Command="{Binding StartBackgroundCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Open Android location permission settings" Command="{Binding BackgroundSettingsCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Stop background run / retry cleanup" Command="{Binding StopBackgroundCommand}" Style="{StaticResource TaskAction}" />
        <Label Text="{Binding BackgroundStatus}" LineBreakMode="WordWrap" />
        <Button Text="Disable selected reminder" Command="{Binding DisableCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Delete selected place" Command="{Binding DeleteCommand}" Style="{StaticResource TaskAction}" />
        <Button Text="Cancel current action" Command="{Binding CancelCommand}" Style="{StaticResource TaskAction}" />
        <Label Text="{Binding Error}" Style="{StaticResource TaskError}" LineBreakMode="WordWrap" />
        <Label Text="{Binding Status}" LineBreakMode="WordWrap" />
        <Label Text="Places and background run records are encrypted locally with an OS-protected key. OS registrations receive saved centers/radii. No sample history or Todo API location upload is saved. Leaving this page cancels page-active work and clears the draft. A completed background opt-in continues until Stop, expiry, invalidation or one arrival attempt, including across account changes. Notifications contain generic text only." Style="{StaticResource TaskMuted}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
