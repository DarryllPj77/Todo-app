<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TodoApp.Maui.ViewModels"
             x:Class="TodoApp.Maui.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="640">
            <Label Text="{Binding Title}" FontSize="32" SemanticProperties.HeadingLevel="Level1"
                   TextColor="{AppThemeBinding Light=#202020, Dark=White}" />
            <Label Text="{Binding Message}" FontSize="18"
                   TextColor="{AppThemeBinding Light=#404040, Dark=#DDDDDD}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
